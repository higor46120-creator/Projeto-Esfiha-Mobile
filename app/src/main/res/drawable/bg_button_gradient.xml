<?xml version="1.0" encoding="utf-8"?>
<!-- Botão principal: gradiente roxo -> azul -> vermelho (igual ao front-end) com efeito de toque -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/ht_purple"
                android:centerColor="@color/ht_blue"
                android:endColor="@color/ht_red"
                android:type="linear" />
        </shape>
    </item>
</ripple>
