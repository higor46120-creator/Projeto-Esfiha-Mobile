<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ht_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ht_tela_padding_h"
        android:paddingTop="@dimen/ht_tela_padding_v"
        android:paddingEnd="@dimen/ht_tela_padding_h"
        android:paddingBottom="@dimen/ht_tela_padding_v">

        <!-- Cabeçalho com gradiente (igual ao topo do formulário no web) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_weight="1">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_logo">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="Chamado"
                        android:src="@drawable/ic_build"
                        android:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abrir chamado"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.9"
                        android:text="Conte o problema e onde ele está"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ações rápidas no cabeçalho -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="horizontal">

                <!-- Só aparece para APROVADOR, SUPORTE, GERENTE e ADMIN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGestao"
                    style="@style/Widget.Helptec.Button.OnGradient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Gestão"
                    android:visibility="gone"
                    app:icon="@drawable/ic_check_circle"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbrirMapa"
                    style="@style/Widget.Helptec.Button.OnGradient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Ver mapa"
                    app:icon="@drawable/ic_place"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSair"
                    style="@style/Widget.Helptec.Button.OnGradient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sair"
                    app:icon="@drawable/ic_logout"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card do formulário -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Helptec.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Paisagem: "O problema" à esquerda, "Onde e urgência" à direita -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/ht_espaco_colunas"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- ===== Seção: O problema ===== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_soft"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_description"
                                android:tint="@color/ht_accent" />

                            <TextView
                                style="@style/TextAppearance.Helptec.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="O problema" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Helptec.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Título">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTitulo"
                                style="@style/Widget.Helptec.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Helptec.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Categoria">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/spCategoria"
                                style="@style/Widget.Helptec.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilDescricao"
                            style="@style/Widget.Helptec.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Descrição"
                            app:endIconContentDescription="Ditar por voz"
                            app:endIconDrawable="@drawable/ic_mic"
                            app:endIconMode="custom"
                            app:endIconTint="@color/ht_accent"
                            app:helperText="Toque no microfone para ditar">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDescricao"
                                style="@style/Widget.Helptec.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="4" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/ht_border" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ht_espaco_colunas"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- ===== Seção: Onde ===== -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_icon_soft"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_place"
                                android:tint="@color/ht_accent" />

                            <TextView
                                style="@style/TextAppearance.Helptec.SectionTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Onde e urgência" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Helptec.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Sala"
                            app:helperText="Escolha da lista ou digite, se não existir">

                            <!-- Sugestões vindas da API; o usuário também pode digitar -->
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etSala"
                                style="@style/Widget.Helptec.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="1"
                                android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Helptec.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Máquina / equipamento"
                            app:helperText="Escolha da lista ou digite, se não existir">

                            <!-- Sugestões vindas da API; o usuário também pode digitar -->
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/etMaquina"
                                style="@style/Widget.Helptec.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:completionThreshold="1"
                                android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Helptec.TextInput.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Prioridade">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/spPrioridade"
                                style="@style/Widget.Helptec.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbrirChamado"
                    style="@style/Widget.Helptec.Button.Gradient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Abrir chamado"
                    app:icon="@drawable/ic_send"
                    app:iconSize="18dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="O aprovador da sua área recebe o chamado assim que você enviar."
            android:textColor="@color/ht_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
